<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:veterinariaInteligente.Controls"
             xmlns:dt="using:veterinariaInteligente.Views.DesignTime"
             xmlns:vm="using:veterinariaInteligente.ViewModels"
             xmlns:models="using:veterinariaInteligente.Models"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
             d:DataContext="{x:Static dt:DesignTimeData.Configuracion}"
             x:DataType="vm:ConfiguracionViewModel"
             x:Class="veterinariaInteligente.Views.ConfiguracionView">

    <Border Background="{StaticResource ContentBackgroundBrush}" Padding="28,22">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="20">
                <StackPanel Spacing="3">
                    <TextBlock Text="Configuración" Classes="sectionTitle"/>
                    <TextBlock Text="Profesionales, respaldos y documentos" Classes="caption"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <controls:ResponsiveTwoPane MinListWidth="260">
                    <Border Classes="card" Padding="20,18">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Profesionales" Classes="subsection"/>
                            <TextBox PlaceholderText="Buscar por nombre o cédula…"
                                     Text="{Binding BusquedaProfesionales}"/>
                            <CheckBox Classes="filtro" Content="Ver inactivos"
                                      IsChecked="{Binding MostrandoInactivos}"/>
                            <ListBox ItemsSource="{Binding ProfesionalesItems}"
                                      SelectedItem="{Binding SelectedProfesional}"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      MinHeight="180" MaxHeight="300">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:Profesional">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Cedula, TargetNullValue='Sin cédula'}" Classes="caption"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Classes="card" Padding="26,20">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Datos del profesional" Classes="subsection"/>
                                <Button Classes="secondary small" HorizontalAlignment="Right"
                                        Command="{Binding NuevoProfesionalCommand}">Nuevo</Button>
                            </StackPanel>
                            <controls:ResponsiveColumnsGrid WideColumns="2" NarrowColumns="1"
                                                            Breakpoint="420" Spacing="14">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Nombre" Classes="fieldLabel"/>
                                    <TextBox PlaceholderText="Nombre completo" Text="{Binding Nombre}"/>
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Cédula" Classes="fieldLabel"/>
                                    <TextBox PlaceholderText="Cédula profesional (opcional)" Text="{Binding Cedula}"/>
                                </StackPanel>
                            </controls:ResponsiveColumnsGrid>
                            <WrapPanel ItemSpacing="8" LineSpacing="8" HorizontalAlignment="Right">
                                <Button Classes="primary small" Command="{Binding AgregarProfesionalCommand}">Crear</Button>
                                <Button Classes="primary small" Command="{Binding ActualizarProfesionalCommand}">Guardar</Button>
                                <Button Classes="danger small" Command="{Binding DesactivarProfesionalCommand}">Desactivar</Button>
                                <Button Classes="secondary small" Command="{Binding ActivarProfesionalCommand}">Activar</Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </controls:ResponsiveTwoPane>

                <controls:ResponsiveColumnsGrid WideColumns="2" NarrowColumns="1" Breakpoint="640" Spacing="22">
                    <Border Classes="card" Padding="26,20">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Respaldo de la base de datos" Classes="subsection"/>
                            <StackPanel Spacing="8">
                                <TextBox PlaceholderText="Carpeta de destino" Text="{Binding CarpetaRespaldo}"/>
                                <Button Classes="secondary small" HorizontalAlignment="Right"
                                        Command="{Binding SeleccionarCarpetaRespaldoCommand}">Elegir carpeta…</Button>
                            </StackPanel>
                            <Button Classes="primary small" HorizontalAlignment="Left"
                                    Command="{Binding CrearRespaldoCommand}">Crear respaldo</Button>
                            <TextBlock Text="{Binding RutaRespaldo, TargetNullValue=''}" Classes="caption" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Classes="card" Padding="26,20">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Datos de la veterinaria" Classes="subsection"/>
                            <controls:ResponsiveColumnsGrid WideColumns="2" NarrowColumns="1"
                                                            Breakpoint="420" Spacing="14">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Nombre" Classes="fieldLabel"/>
                                    <TextBox PlaceholderText="Nombre de la veterinaria" Text="{Binding NombreVeterinaria}"/>
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Teléfono" Classes="fieldLabel"/>
                                    <TextBox PlaceholderText="Teléfono" Text="{Binding TelefonoVeterinaria}"/>
                                </StackPanel>
                            </controls:ResponsiveColumnsGrid>
                            <StackPanel Spacing="5">
                                <TextBlock Text="Dirección" Classes="fieldLabel"/>
                                <TextBox PlaceholderText="Dirección de la veterinaria" Text="{Binding DireccionVeterinaria}"/>
                            </StackPanel>
                            <Button Classes="primary small" HorizontalAlignment="Right"
                                    Command="{Binding GuardarConfiguracionCommand}">Guardar datos</Button>
                        </StackPanel>
                    </Border>
                </controls:ResponsiveColumnsGrid>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
