<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="using:veterinariaInteligente.Styles"
             xmlns:dt="using:veterinariaInteligente.Views.DesignTime"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
             d:DataContext="{x:Static dt:DesignTimeData.Expediente}"
             x:DataType="dt:ExpedienteDesignTime"
             x:Class="veterinariaInteligente.Views.ExpedienteView">

    <UserControl.Resources>
        <conv:InicialesConverter x:Key="Iniciales"/>
    </UserControl.Resources>

    <Border Background="{StaticResource ContentBackgroundBrush}" Padding="28,22">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="22" MaxWidth="980" HorizontalAlignment="Left">

                <StackPanel Spacing="3">
                    <TextBlock Text="Expediente" Classes="sectionTitle"/>
                    <TextBlock Text="Resumen del paciente y su propietario" Classes="caption"/>
                </StackPanel>

                <Border Classes="card">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                        <Border Width="64" Height="64" CornerRadius="32"
                                Background="{StaticResource PrimaryButtonBrush}">
                            <TextBlock Text="{Binding MascotaActual.Nombre, Converter={StaticResource Iniciales}}"
                                       FontSize="20" FontWeight="ExtraBold" FontFamily="avares://veterinariaInteligente/Assets/Fonts/Nunito-ExtraBold.ttf#Nunito ExtraBold"
                                       Foreground="{StaticResource SurfaceBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                            <TextBlock Text="{Binding MascotaActual.Nombre}"
                                       FontSize="20" FontWeight="ExtraBold" FontFamily="avares://veterinariaInteligente/Assets/Fonts/Nunito-ExtraBold.ttf#Nunito ExtraBold"
                                       Foreground="{StaticResource NavyBrush}"/>
                            <TextBlock Text="{Binding MascotaActual.Raza}" Classes="subsectionSoft"/>
                        </StackPanel>
                        <Border Grid.Column="2" Classes="chip" VerticalAlignment="Center"
                                Background="#EAFCEF">
                            <TextBlock Text="{Binding MascotaActual.Estado.Nombre}"
                                       FontSize="12" FontWeight="Bold" FontFamily="avares://veterinariaInteligente/Assets/Fonts/Nunito-Bold.ttf#Nunito Bold"
                                       Foreground="{StaticResource SuccessBrush}"/>
                        </Border>
                    </Grid>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Datos generales" Classes="subsection"/>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16"
                              RowDefinitions="Auto,Auto" RowSpacing="14">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Raza" Classes="fieldLabel"/>
                                <TextBlock Text="{Binding MascotaActual.Raza}" FontSize="14" FontWeight="SemiBold" FontFamily="avares://veterinariaInteligente/Assets/Fonts/Nunito-SemiBold.ttf#Nunito SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Sexo" Classes="fieldLabel"/>
                                <TextBlock Text="{Binding MascotaActual.Sexo}" FontSize="14" FontWeight="SemiBold" FontFamily="avares://veterinariaInteligente/Assets/Fonts/Nunito-SemiBold.ttf#Nunito SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Text="Color" Classes="fieldLabel"/>
                                <TextBlock Text="{Binding MascotaActual.Color}" FontSize="14" FontWeight="SemiBold" FontFamily="avares://veterinariaInteligente/Assets/Fonts/Nunito-SemiBold.ttf#Nunito SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Spacing="4">
                                <TextBlock Text="Alergias" Classes="fieldLabel"/>
                                <TextBlock Text="{Binding MascotaActual.Alergia, TargetNullValue='Sin alergias conocidas'}"
                                           FontSize="14" FontWeight="SemiBold" FontFamily="avares://veterinariaInteligente/Assets/Fonts/Nunito-SemiBold.ttf#Nunito SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                <TextBlock Text="Fecha de nacimiento" Classes="fieldLabel"/>
                                <TextBlock Text="{Binding MascotaActual.FechaNacimiento, StringFormat='{}{0:dd/MM/yyyy}', TargetNullValue='No registrada'}"
                                           FontSize="14" FontWeight="SemiBold" FontFamily="avares://veterinariaInteligente/Assets/Fonts/Nunito-SemiBold.ttf#Nunito SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Spacing="4">
                                <TextBlock Text="Estado" Classes="fieldLabel"/>
                                <TextBlock Text="{Binding MascotaActual.Estado.Nombre}" FontSize="14" FontWeight="SemiBold" FontFamily="avares://veterinariaInteligente/Assets/Fonts/Nunito-SemiBold.ttf#Nunito SemiBold"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Propietario" Classes="subsection"/>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                            <Border Width="46" Height="46" CornerRadius="23" Background="#E7F6FD">
                                <TextBlock Text="{Binding DuenioActual.Nombre, Converter={StaticResource Iniciales}}"
                                           FontSize="15" FontWeight="Bold" FontFamily="avares://veterinariaInteligente/Assets/Fonts/Nunito-Bold.ttf#Nunito Bold"
                                           Foreground="{StaticResource NavyBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Top" Spacing="2">
                                <TextBlock Text="{Binding DuenioActual.Nombre}" FontSize="15" FontWeight="Bold" FontFamily="avares://veterinariaInteligente/Assets/Fonts/Nunito-Bold.ttf#Nunito Bold"/>
                                <TextBlock Text="{Binding DuenioActual.Telefono}" Classes="caption"/>
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Correo" Classes="fieldLabel"/>
                                <TextBlock Text="{Binding DuenioActual.Correo, TargetNullValue='No registrado'}"
                                           FontSize="14" FontWeight="SemiBold" FontFamily="avares://veterinariaInteligente/Assets/Fonts/Nunito-SemiBold.ttf#Nunito SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Dirección" Classes="fieldLabel"/>
                                <TextBlock Text="{Binding DuenioActual.Direccion, TargetNullValue='No registrada'}"
                                           FontSize="14" FontWeight="SemiBold" FontFamily="avares://veterinariaInteligente/Assets/Fonts/Nunito-SemiBold.ttf#Nunito SemiBold" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="card" Background="{StaticResource SurfaceAltBrush}"
                        BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Historial clínico" Classes="subsection"/>
                        <Border Background="#EAF6FD" CornerRadius="10" Padding="16,12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Las consultas de esta mascota se mostrarán aquí."
                                           Classes="subsectionSoft"/>
                                <TextBlock Text="Este bloque se integra con el módulo m3 · Consultas (contrato: ConsultaService)."
                                           Classes="caption"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>