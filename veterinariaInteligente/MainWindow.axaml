<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:veterinariaInteligente.Views"
        xmlns:vm="using:veterinariaInteligente.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:DataType="vm:MainViewModel"
        x:Class="veterinariaInteligente.MainWindow"
        Title="PawDesk"
        Icon="avares://veterinariaInteligente/Assets/Logo.ico"
        Width="1280" Height="800"
        MinWidth="1100" MinHeight="700"
        Background="{StaticResource ContentBackgroundBrush}">

    <Window.DataTemplates>
        <DataTemplate DataType="vm:PropietariosViewModel">
            <views:PropietariosView/>
        </DataTemplate>
        <DataTemplate DataType="vm:ExpedienteViewModel">
            <views:ExpedienteView/>
        </DataTemplate>
        <DataTemplate DataType="vm:ConsultasViewModel">
            <views:ConsultasView/>
        </DataTemplate>
        <DataTemplate DataType="vm:CitasViewModel">
            <views:CitasView/>
        </DataTemplate>
        <DataTemplate DataType="vm:PendientesViewModel">
            <views:PendientesView/>
        </DataTemplate>
        <DataTemplate DataType="vm:VacunasViewModel">
            <views:VacunasView/>
        </DataTemplate>
        <DataTemplate DataType="vm:ConfiguracionViewModel">
            <views:ConfiguracionView/>
        </DataTemplate>
        <DataTemplate DataType="vm:InicioViewModel">
            <views:InicioView/>
        </DataTemplate>
    </Window.DataTemplates>

    <Grid ColumnDefinitions="262,*">

        <views:SidebarView Grid.Column="0"/>

        <Grid Grid.Column="1" RowDefinitions="76,*">

            <Border Grid.Row="0"
                    Background="{StaticResource NavyGradientBrush}"
                    Padding="28,0">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="PawDesk"
                                   FontSize="19" FontWeight="ExtraBold" FontFamily="avares://veterinariaInteligente/Assets/Fonts/Nunito-ExtraBold.ttf#Nunito ExtraBold"
                                   Foreground="{StaticResource SurfaceBrush}"/>
                        <TextBlock Text="{Binding TituloVistaActual}"
                                   FontSize="12" FontWeight="SemiBold" FontFamily="avares://veterinariaInteligente/Assets/Fonts/Nunito-SemiBold.ttf#Nunito SemiBold"
                                   Foreground="{StaticResource SidebarTextBrush}"
                                   Opacity="0.75"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding VistaActual}"/>

        </Grid>
    </Grid>
</Window>
